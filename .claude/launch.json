{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "apps/web", "--", "--port", "5173", "--strictPort"],
      "port": 5173
    },
    {
      "name": "api",
      "runtimeExecutable": "apps/api/.venv/Scripts/python",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--reload", "--port", "8000", "--app-dir", "apps/api"],
      "port": 8000
    },
    {
      "name": "fixtures",
      "runtimeExecutable": "apps/api/.venv/Scripts/python",
      "runtimeArgs": ["evals/serve.py"],
      "port": 8102
    }
  ]
}
