# API (apps/api/.env)
# Models: free providers. Groq is primary, Gemini is the fallback. Anthropic only when a key exists.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Fallback chain (comma separated, tried in order, zero retries)
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
GEMINI_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite
# Report writer only: tried right after the first Groq model. Slow (about 60 s) but careful. Blank key skips it.
OPENROUTER_API_KEY=
OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free
# Scout, the @Scout assistant in team chat (app/scout.py). Its own provider: never uses the Groq or Gemini keys.
# A key from a separate OpenRouter account keeps Scout's free daily requests apart from the report writer's.
SCOUT_OPENROUTER_API_KEY=
SCOUT_MODELS=nvidia/nemotron-3-ultra-550b-a55b-20260604:free,nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3.5-lightning:free
SCOUT_DAILY=50
# Pro and Plus: Claude Haiku 4.5 on Google Cloud (Vertex AI). Blank project = off (free models for everyone).
CLAUDE_VERTEX_PROJECT=
CLAUDE_VERTEX_REGION=global
CLAUDE_MODEL=claude-haiku-4-5@20251001
# Path to a Google Cloud service-account key with Vertex AI access (never commit the file)
GOOGLE_APPLICATION_CREDENTIALS=
# memory (default) or postgres (production next to the database)
CHECKPOINTER=memory
# Free test runs allowed per day across all users (about 80% of the free model budget)
FREE_RUNS_PER_DAY=90
FREE_SCANS_PER_DAY=200
ANTHROPIC_API_KEY=
PAID_MODEL=claude-haiku-4-5
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Walkthru
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=
PAGESPEED_API_KEY=
# ---- Dodo Payments (V10 billing, payment.md). Paste into apps/api/.env only, never into apps/web/.env. ----
# Dodo dashboard > Developer > API Keys. Test mode and live mode have DIFFERENT keys, webhook secrets and products.
DODO_PAYMENTS_API_KEY=
# Dodo dashboard > Developer > Webhooks > your endpoint > Signing secret (starts with whsec_)
DODO_PAYMENTS_WEBHOOK_KEY=
# Dodo dashboard > Settings > Business (the bus_... id). Webhooks for any other business are refused.
DODO_PAYMENTS_BUSINESS_ID=
# test_mode or live_mode. Stays test_mode until live verification clears and the founder switches it.
DODO_PAYMENTS_ENVIRONMENT=test_mode
# One-time products (not subscriptions), USD, tax category SaaS. Copy each pdt_... id from Dodo > Products.
DODO_PRODUCT_LAUNCH=            # Launch Pack, $9.00
DODO_PRODUCT_PRO_FOUNDING=      # Pro founding, $15.00
DODO_PRODUCT_PRO=               # Pro, $19.00
DODO_PRODUCT_PLUS_FOUNDING=     # Plus founding, $39.00
DODO_PRODUCT_PLUS=              # Plus, $49.00
# Name written to admin_audit_log by scripts/billing.py (defaults to your OS user name)
WALKTHRU_ADMIN=
RESEND_API_KEY=
RESEND_FROM=Walkthru <onboarding@resend.dev>
WEB_URL=http://localhost:5173
# ALLOW_LOCAL_SCANS=1   dev only: allow scanning 127.0.0.1 fixtures
# Web (apps/web/.env, Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:8010
