      "seed": 73139,
      "version": 1,
      "versionNonce": 11227,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "fontSize": 18,
      "fontFamily": 2,
      "text": "Owned running row, evidence path scope, current pending checkpoint ID,\nabuse pause, site-exit category and signed-in visitor guards.\nMissing live state after restart → _stop_run preserves the partial history.\nResume same thread with validated Observation + optional StepEvidence.\n_reply writes status, full steps and token total after each turn.\nRunning reply returns interrupt.value and checkpoint_id as action_id.\nTerminal reply queues finish_run. Stop can also enqueue a partial report.",
      "originalText": "Owned running row, evidence path scope, current pending checkpoint ID,\nabuse pause, site-exit category and signed-in visitor guards.\nMissing live state after restart → _stop_run preserves the partial history.\nResume same thread with validated Observation + optional StepEvidence.\n_reply writes status, full steps and token total after each turn.\nRunning reply returns interrupt.value and checkpoint_id as action_id.\nTerminal reply queues finish_run. Stop can also enqueue a partial report.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
