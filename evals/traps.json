[
  {"id": "U1", "site": "hard", "kind": "ux", "page": "/", "trap": "Signup entry point hidden: only a tiny 'Create account' link in the footer; nav has Log in but no Sign up", "expect": "signup hard to find", "match": ["signup is hard to find", "sign-up is hidden", "sign up is hidden", "could not find sign-up", "could not find sign up"]},
